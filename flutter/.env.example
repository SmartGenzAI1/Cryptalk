# Cryptalk Mobile Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.

# Backend API URL (no trailing slash)
# Local dev: http://10.0.2.2:8001 (Android emulator)
# Production: https://your-backend.onrender.com
BACKEND_URL=http://localhost:8001

# Supabase (for file storage)
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Email Verification ──
# When backend has EMAIL_VERIFICATION_ENABLED=true, the auth screen
# will show a "Verify your email" notice after registration.
# Forgot password and reset are handled server-side — no mobile config needed.
