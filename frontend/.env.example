# ── Cryptalk Frontend Environment ──
# Copy to .env.local for local dev. Set in Vercel dashboard for production.
# IMPORTANT: Never commit .env — use .env.example as the template.
# No secrets belong on the frontend — all crypto is client-side.

# Development (local)
# The API client appends ?XTransformPort=BACKEND_PORT to all requests
NEXT_PUBLIC_BACKEND_PORT=8001

# Production (Vercel + Render)
# Set this to your Render backend URL — the API client will call it directly
# NEXT_PUBLIC_BACKEND_URL=https://cryptalk-api.onrender.com

# Backend URL used by next.config.ts rewrites (server-side only, NOT public)
# Only needed if not using NEXT_PUBLIC_BACKEND_URL above
# BACKEND_URL=http://localhost:8001

# ── Production (Vercel dashboard) ──
# Supabase project — anon key only (safe to expose client-side; NEVER the service key)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Canonical frontend URL — must match CORS_ORIGINS on the backend
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Email Verification ──
# When backend sets EMAIL_VERIFICATION_ENABLED=true, users will see a
# verification notice banner after registering. No frontend config needed —
# the /verify-email and /resend-verification endpoints are handled server-side.
