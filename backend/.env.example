# ── Cryptalk Backend Environment ──
# Copy to .env for local dev. Set in Render dashboard for production.
# IMPORTANT: Never commit .env — use .env.example as the template.

PORT=8001
DEBUG=False

# Database
# Option A: SQLite (local development — default)
DB_PATH=./db/cryptalk.db

# === OPTION B: Neon DB (Production - Free Tier) ===
# Get from: neon.tech → create account → create project → copy connection string
# Pool tuning: NEON_POOL_SIZE=2, NEON_MAX_OVERFLOW=1 (fits free-tier 20-connection limit)
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cryptalk?sslmode=require

# Option C: Supabase PostgreSQL (production)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── SECRETS ──
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters
SESSION_SECRET=

COOKIE_NAME=tc_session
COOKIE_MAX_AGE=2592000

# CORS — comma-separated list of allowed origins
# Production: https://your-app.vercel.app
# Development: http://localhost:3000
CORS_ORIGINS=*

# ── Redis (Upstash free tier) ──
# For multi-process Socket.IO scaling + distributed rate limiting
# Get from: upstash.com → create Redis database
# REDIS_URL=redis://default:PASSWORD@HOST.upstash.io:6379

# ── Sentry (free tier) ──
# For error tracking in production
# Get from: sentry.io → create project → FastAPI
# SENTRY_DSN=https://KEY@sentry.io/ID

# ── Supabase ──
# For file storage (images, documents)
# Get from: Supabase dashboard → Settings → API
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_KEY=eyJhbG...

# ── Welcome Channel ──
WELCOME_CHANNEL_ID=welcome-channel

# ── Email (SMTP) ──
# For account verification, password reset emails, and welcome messages.
# Works with any SMTP provider (Gmail, SendGrid, Mailgun, Brevo, etc.)
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password    (NOT your Gmail password — use an app password)
#   SMTP_FROM_EMAIL=you@gmail.com
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.xxxxx
#   SMTP_FROM_EMAIL=noreply@yourdomain.com
#
# Brevo (Sendinblue) example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-email
#   SMTP_PASSWORD=your-brevo-key
#   SMTP_FROM_EMAIL=noreply@yourdomain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Set to "true" to require email verification after registration.
# When false, emails are sent but not required to use the app.
EMAIL_VERIFICATION_ENABLED=false

# ── File Storage Limits ──
# MAX_FILE_SIZE_BYTES=26214400
# STORAGE_QUOTA_BYTES=996147200
# FILE_RETENTION_HOURS=1
