# ── Cryptalk Backend Environment ──
# Copy to .env for local dev. Set in Render dashboard for production.
# IMPORTANT: Never commit .env — use .env.example as the template.

PORT=8001
DEBUG=False

# ── Neon DB (Required — the only database) ──
# 1. Go to neon.tech → create free account
# 2. Create a project → copy the connection string
# 3. Paste below (replace with your actual connection string)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cryptalk?sslmode=require

# ── SECRETS ──
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters
SESSION_SECRET=

COOKIE_NAME=tc_session
COOKIE_MAX_AGE=2592000

# CORS — comma-separated list of allowed origins
# Production: https://your-app.vercel.app
# Development: http://localhost:3000
CORS_ORIGINS=*

# ── Redis (Upstash free tier — optional) ──
# For multi-process Socket.IO scaling + distributed rate limiting
# Get from: upstash.com → create Redis database
# REDIS_URL=redis://default:PASSWORD@HOST.upstash.io:6379

# ── Sentry (free tier — optional) ──
# For error tracking in production
# SENTRY_DSN=https://KEY@sentry.io/ID

# ── Supabase (for file storage) ──
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_KEY=eyJhbG...

# ── Welcome Channel ──
WELCOME_CHANNEL_ID=welcome-channel

# ── Email (SMTP — optional) ──
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password
#   SMTP_FROM_EMAIL=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

EMAIL_VERIFICATION_ENABLED=false

# ── File Storage Limits ──
# MAX_FILE_SIZE_BYTES=26214400
# STORAGE_QUOTA_BYTES=996147200
# FILE_RETENTION_HOURS=1
